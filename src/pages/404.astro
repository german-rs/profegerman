---
import Layout from '../layouts/Layout.astro';
import illustration from '../../public/illustrations/404-img.webp';
---

<Layout>
	<main id="not-found">
		<section class="card">
			<img
				src={illustration.src}
				width={illustration.width}
				height={illustration.height}
				alt="Ilustración de una persona de pie junto a un letrero con dos flechas, mostrando que hay más de un camino por seguir"
			/>
			<h1>Sigamos por el buen camino</h1>
			<p>Este enlace cambió de lugar. Desde aquí puedes llegar a lo que buscabas.</p>
			<div class="actions">
				<a class="button button--primary" href="/">Volver al inicio</a>
				<a class="button button--secondary" href="/#cursos">Ver los cursos</a>
			</div>
		</section>
	</main>
</Layout>

<style>
	#not-found {
		min-height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 2rem 1rem;
		background: #fdf8f3;
		font-family: 'Atkinson Hyperlegible', Lexend, Inter, Roboto, 'Helvetica Neue', Arial,
			sans-serif;
		color: #2e2a27;
	}

	.card {
		width: 100%;
		max-width: 28rem;
		text-align: center;
		background: #ffffff;
		border: 1px solid rgba(46, 42, 39, 0.1);
		border-radius: 1.25rem;
		padding: 2.5rem 2rem;
	}

	img {
		display: block;
		margin: 0 auto 1.5rem;
		max-width: 13.75rem;
		height: auto;
	}

	h1 {
		font-size: 1.75rem;
		line-height: 1.3;
		margin: 0 0 0.75rem;
		font-weight: 700;
	}

	p {
		font-size: 1.125rem;
		line-height: 1.6;
		margin: 0 0 2rem;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		justify-content: center;
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.75rem; /* ~44px, tap target mínimo */
		padding: 0.75rem 1.5rem;
		border-radius: 0.625rem;
		font-size: 1.125rem;
		font-weight: 600;
		text-decoration: none;
		transition: background-color 0.2s ease, border-color 0.2s ease;
	}

	.button--primary {
		background: #d96c4b;
		color: #ffffff;
		border: 1px solid #d96c4b;
	}

	.button--primary:hover {
		background: #c25f40;
		border-color: #c25f40;
	}

	.button--secondary {
		background: transparent;
		color: #2e2a27;
		border: 1px solid #2e2a27;
	}

	.button--secondary:hover {
		background: rgba(46, 42, 39, 0.06);
	}

	.button:focus-visible {
		outline: 2px solid #2e2a27;
		outline-offset: 2px;
	}

	@media (prefers-reduced-motion: reduce) {
		.button {
			transition: none;
		}
	}

	@media (max-width: 30rem) {
		.actions {
			flex-direction: column;
		}

		.button {
			width: 100%;
		}
	}
</style>