---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/sections/Hero.astro";
import PilaresMensaje from "../components/sections/PilaresMensaje.astro";
import CursosGrid from "../components/sections/CursosGrid.astro";
import AccesibilidadBanner from "../components/sections/AccesibilidadBanner.astro";
import CTAWhatsAppBanner from "../components/sections/CTAWhatsAppBanner.astro";
---

<Layout>
  <Hero />
  <PilaresMensaje />
  <CursosGrid />
  <AccesibilidadBanner />

  <CTAWhatsAppBanner
    titulo="¿Empezamos?"
    texto="Escríbeme y cuéntame qué te gustaría aprender. Vemos juntos por dónde partir."
    ctaMensaje="Hola profe, quiero saber más de las clases"
    ctaTexto="Escríbeme por WhatsApp"
  />
</Layout>