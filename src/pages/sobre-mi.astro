---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/sections/PageHero.astro";
import PageHeroProfe from "../components/sections/PageHeroProfe.astro";
import profeHero from "/public/illustrations/sobre-mi-hero.webp";
import CTAWhatsAppBanner from "../components/sections/CTAWhatsAppBanner.astro";
import parejaMensaje from "/public/illustrations/pareja-mensaje.webp";
import profeMadre from "/public/illustrations/sobre-mi-quien-soy.webp";
import { Image } from "astro:assets";


const ctaMensaje = "Hola profe, quiero conocerte más.";

const hitos = [
  {
    titulo: "Soporte técnico",
    texto:
      "Empecé arreglando computadores y resolviendo los problemas del día a día de las personas. Ahí aprendí a explicar con claridad a quien necesita ayuda y no sabe por dónde empezar.",
  },
  {
    titulo: "Docencia",
    texto:
      "Fui profesor en educación superior, enseñando programación y ofimática. Saber de tecnología es una cosa y saber enseñarla es otra: formarme como docente me permite ver dónde te atascas y explicarlo de otra manera.",
  },
  {
    titulo: "Desarrollo y consultoría",
    texto:
      "Además de conocer la teoría: he trabajado como desarrollador y consultor. Por eso, cuando te muestro un computador, uso lo que realmente existe hoy y no un manual de hace 20 años.",
  },
  {
    titulo: "Clases particulares",
    texto:
      "Hoy enseño uno a uno, a domicilio y a tu ritmo, con toda esa experiencia puesta al servicio de una sola persona.",
  },
];

type Color = "primary" | "success" | "accessibility" | "profe";

const formas: {
  titulo: string;
  texto: string;
  color: Color;
  icono: string;
}[] = [
  {
    titulo: "Sin prisa",
    texto:
      "Avanzamos con calma y volvemos a explicar cuantas veces haga falta, hasta que todo quede claro.",
    color: "profe",
    icono: `<circle cx="12" cy="12" r="9" /><path d="M12 7v5l3.5 2" />`,
  },
  {
    titulo: "A tu ritmo",
    texto:
      "Algunas personas aprenden rápido, otras necesitan más tiempo. Ambas están bien. Cada clase se ajusta a ti.",
    color: "success",
    icono: `<circle cx="12" cy="12" r="9" /><path d="M8 12.5l2.5 2.5L16 9" />`,
  },
  {
    titulo: "Claro y cercano",
    texto:
      "Explico con palabras simples y traduzco cada término técnico. Conversamos de persona a persona, sin manuales.",
    color: "primary",
    icono: `<path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z" /><path d="M9 11h6" /><path d="M9 14h4" />`,
  },
  {
    titulo: "Adaptado a ti",
    texto:
      "Cada persona aprende de forma distinta. Diseño cada clase según tu situación, tus capacidades e intereses.",
    color: "accessibility",
    icono: `<circle cx="12" cy="12" r="9" /><circle cx="12" cy="7" r="1.4" fill="currentColor" stroke="none" /><path d="M12 8.8v4.5" /><path d="M12 10.2L8 7.6" /><path d="M12 10.2L16 7.6" /><path d="M12 13.3L9 17" /><path d="M12 13.3L15 17" />`,
  },
];

// Clases completas para que Tailwind las detecte en el build. No partir estos strings.
const estilosForma: Record<Color, { card: string; icon: string }> = {
  primary: { card: "bg-primary/15", icon: "text-primary" },
  success: { card: "bg-success/15", icon: "text-success" },
  accessibility: { card: "bg-accessibility/15", icon: "text-accessibility" },
  profe: { card: "bg-profe/15", icon: "text-profe" },
};

---

<Layout
  title="Sobre mí | Germán Riveros | Profe Germán"
  description="Soy Germán Riveros, ingeniero en informática y profesor de computación. Enseño con paciencia, experiencia técnica y accesibilidad, especialmente en Lengua de Señas Chilena."
>
<PageHeroProfe
  kicker="Conoce al profe"
  titulo="Sobre mí"
  subtitulo="Soy Germán, ingeniero en informática y profesor particular. 
  Hace más de 10 años enseño computación y celular para que 
  uses la tecnología con seguridad."
  ctaMensaje={ctaMensaje}
  ctaTexto="Escríbeme por WhatsApp"
  imagen={profeHero}
  imagenAlt="Germán, el profe, de pie y saludando con una mano"
/>

  <!-- Sección: Quién soy -->
<section
  class="relative before:absolute before:inset-0 before:-z-20 before:bg-[#e4ead9]"
  aria-labelledby="quien-soy-titulo"
>
  <div class="container grid items-center gap-12 py-16 md:grid-cols-[3fr_2fr] md:gap-16 md:py-24">
    <div class="max-w-prose">
      <h2 id="quien-soy-titulo" class="text-3xl font-bold">Quién soy</h2>

      <p class="mt-6 text-2xl font-bold leading-snug md:text-3xl">
        Que aprendas a usar la tecnología sin sentirte perdido.
      </p>

      <p class="mt-6 text-lg">
        Quiero que entiendas qué estás haciendo y por qué, no solo que sigas
        botones sin saber qué pasará después.
      </p>

      <p class="mt-6 text-lg">
        Me llamo <strong>Germán Riveros</strong>. He trabajado en tecnología
        arreglando computadores, escribiendo software y enseñando en
        educación superior, y ahora doy clases particulares. Esa combinación de
        experiencia técnica y pedagógica es lo que me hace diferente como
        profesor.
      </p>

      <ul class="mt-8 flex flex-wrap gap-3">
        {
          [
            "Ingeniero en Informática",
            "Magíster en Docencia para la Educación Superior",
            "Lengua de Señas Chilena",
            "Santiago · clases a domicilio",
          ].map((dato) => (
            <li class="rounded-full border border-black/10 bg-white/70 px-4 py-2 text-base font-bold">
              {dato}
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Destino del círculo: aquí aterriza y se convierte en arco -->
    <div class="mx-auto w-full max-w-sm md:max-w-none">
      <div data-destino class="relative aspect-[4/5] w-full">
        <div data-destino-fondo class="arco absolute inset-0 bg-profe/30" aria-hidden="true"></div>
        <Image
          data-destino-img
          src={profeMadre}
          alt="Una mujer mayor usa un computador portátil mientras Germán, sentado a su lado, le muestra algo en la pantalla"
          class="relative h-full w-full object-contain"
        />
      </div>
    </div>
  </div>
</section>

<style>
  /* Arco: mitad superior redonda y esquinas inferiores suaves (aspecto 4:5) */
  .arco {
    border-radius: 50% 50% 1.5rem 1.5rem / 40% 40% 1.5rem 1.5rem;
  }
  /* Línea de tiempo: por defecto (sin JS o con "reducir movimiento") todo se ve encendido */
.hito::before {
  content: "";
  position: absolute;
  left: 7px;
  top: 14px;
  width: 2px;
  height: 100%;
  background: var(--color-profe);
}
.hito:last-child::before {
  display: none;
}
.marca {
  background: var(--color-profe);
  border-color: var(--color-profe);
}

/* Con el recorrido activo, todo parte apagado y se enciende al pasar el punto */
.con-recorrido .hito::before {
  background: rgb(0 0 0 / 0.1);
}
.con-recorrido .hito .marca {
  background: transparent;
  border-color: rgb(0 0 0 / 0.2);
  transition: background-color 0.3s, border-color 0.3s;
}
.con-recorrido .hito .contenido {
  opacity: 0.55;
  transform: translateY(6px);
  transition: opacity 0.4s, transform 0.4s;
}
.con-recorrido .hito.is-activo .marca {
  background: var(--color-profe);
  border-color: var(--color-profe);
}
.con-recorrido .hito.is-activo .contenido {
  opacity: 1;
  transform: none;
}
</style>

<!-- Sección: Mi experiencia -->
<section class="py-16 md:py-24" aria-labelledby="experiencia-titulo">
  <div class="container">
    <div class="max-w-3xl">
      <h2 id="experiencia-titulo" class="text-3xl font-bold">Mi experiencia</h2>

      <div class="relative mt-12" data-linea>
        <!-- Tramo de la línea que el punto ya recorrió -->
        <span
          class="absolute left-[7px] top-[14px] w-0.5 bg-profe"
          style="height: 0"
          data-progreso
          aria-hidden="true"
        ></span>

        <ol>
          {
            hitos.map((hito) => (
              <li class="hito relative pb-12 pl-10 last:pb-0 md:pl-14" data-hito>
                <span
                  class="marca absolute left-0 top-[6px] size-4 rounded-full border-2"
                  data-marca
                  aria-hidden="true"
                />
                <div class="contenido">
                  <h3 class="text-xl font-bold">{hito.titulo}</h3>
                  <p class="mt-3 max-w-prose text-lg">{hito.texto}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>

      <!-- Cierre: accesibilidad -->
<div class="mt-12 rounded-lg border border-black/10 bg-accessibility/10 p-6 md:p-8">
  <h3 class="text-xl font-bold">Me comunico en Lengua de Señas Chilena</h3>
  <p class="mt-3 max-w-prose text-lg">
    La accesibilidad no es un agregado para mí, si tienes dificultades
    auditivas o prefieres aprender en lengua de señas, aquí estoy. También
    puedo adaptar clases para personas con baja visión, dislexia, o cualquier
    necesidad que tengas.
  </p>
</div>
    </div>
  </div>
</section>

   <!-- Sección: Cómo trabajo -->
  <section class="container py-16 md:py-20" aria-labelledby="como-trabajo-titulo">
    <div class="max-w-3xl">
      <h2 id="como-trabajo-titulo" class="text-3xl font-bold">Cómo trabajo</h2>

      <ul class="mt-10 grid list-none grid-cols-1 gap-6 p-0 md:grid-cols-2">
        {
          formas.map((forma) => (
            <li class={`card-hover rounded-lg p-6 ${estilosForma[forma.color].card}`}>
              <span
                aria-hidden="true"
                class="flex h-12 w-12 items-center justify-center rounded-full bg-background"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class={`h-6 w-6 ${estilosForma[forma.color].icon}`}
                  set:html={forma.icono}
                />
              </span>

              <h3 class="mt-4 text-xl font-bold">{forma.titulo}</h3>
              <p class="mt-2 text-base">{forma.texto}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Sección: Enlace a germanriveros.cl -->
  <section
    class="border-y border-black/10 bg-accessibility/10 py-12 md:py-16"
    aria-labelledby="germanriveros-titulo"
  >
    <div class="container">
      <div class="max-w-3xl">
        <h2 id="germanriveros-titulo" class="text-2xl font-bold">
          ¿Necesitas servicios técnicos?
        </h2>

        <p class="mt-4 max-w-prose text-lg">
          Si lo que buscas es ayuda con mantenimiento de sitios web,
          optimización, o consultoría técnica, tengo un sitio separado: &nbsp; 
          <a class="text-link" href="https://germanriveros.cl" rel="noopener noreferrer">
            germanriveros.cl
          </a>
          . Allí está mi portafolio profesional.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA final -->
  <CTAWhatsAppBanner
    titulo="¿Quieres empezar?"
    texto="Cuéntame en qué te gustaría aprender. Podemos charlar sin compromiso."
    ctaMensaje={ctaMensaje}
    ctaTexto="Escríbeme por WhatsApp"
    imagen={parejaMensaje}
    imagenAlt="Una mujer mayor muestra un mensaje en su celular a un hombre mayor, que lo mira sonriendo"
    anclaje="cabeza"

  />
</Layout>