---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PostCard from "../../components/ui/PostCard.astro";

const posts = (
  await getCollection("blog", ({ data }) => (import.meta.env.PROD ? !data.draft : true))
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title="Blog | Profe Germán"
  description="Consejos claros y sin tecnicismos sobre computador, celular y seguridad digital, para adultos y personas mayores."
>
  <header class="bg-primary/10 py-14 text-center md:py-20">
    <div class="container">
      <h1 class="mx-auto m-0 max-w-2xl text-3xl font-bold md:text-5xl">
        Consejos para usar mejor tu computador y tu celular
      </h1>
      <p class="mx-auto mt-4 mb-0 max-w-xl text-lg">
        Explicaciones claras, paso a paso y sin tecnicismos.
      </p>
    </div>
  </header>

  <section class="container py-14" aria-label="Artículos">
    {
      posts.length > 0 ? (
        <ul class="m-0 grid list-none gap-8 p-0 md:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <li>
              <PostCard post={post} />
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-center">Pronto publicaré el primer artículo.</p>
      )
    }
  </section>
</Layout>