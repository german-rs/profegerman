---
import { getCollection } from "astro:content";
import PostCard from "../ui/PostCard.astro";

// No se muestra hasta que existan al menos 3 artículos publicados
const MIN_POSTS = 3;

const all = (
  await getCollection("blog", ({ data }) => (import.meta.env.PROD ? !data.draft : true))
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const posts = all.slice(0, 3);
---

{
  all.length >= MIN_POSTS && (
    <section class="py-16 md:py-24" aria-labelledby="blog-titulo">
      <div class="container">
        <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
          <div>
            <h2 id="blog-titulo" class="m-0 text-3xl font-bold">
              Consejos para usar mejor tu celular
            </h2>
            <p class="mt-2 mb-0 max-w-prose">
              Explicaciones claras, paso a paso y sin tecnicismos.
            </p>
          </div>
          <a class="button button--secondary self-start md:self-auto" href="/blog/">
            Ver todos los artículos
          </a>
        </div>

        <ul class="m-0 mt-10 grid list-none gap-8 p-0 md:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <li>
              <PostCard post={post} headingLevel="h3" />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}