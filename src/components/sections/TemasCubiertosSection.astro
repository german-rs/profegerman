---
interface Tema {
  titulo: string;
  descripcion: string;
}

interface Props {
  titulo?: string;
  temas: Tema[];
}

const { titulo = "Qué vamos a ver juntos", temas } = Astro.props;
---

<section class="container py-16 md:py-20" aria-labelledby="temas-titulo">
  <h2 id="temas-titulo" class="text-2xl font-bold md:text-3xl">
    {titulo}
  </h2>

  <ul class="mt-8 grid list-none gap-6 p-0 md:grid-cols-2">
    {
      temas.map((tema) => (
        <li class="rounded-lg border border-black/10 bg-white/60 p-6">
          <h3 class="text-lg font-bold">{tema.titulo}</h3>
          <p class="mt-2 text-base">{tema.descripcion}</p>
        </li>
      ))
    }
  </ul>
</section>