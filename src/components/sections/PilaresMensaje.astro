---
// Copy tomado directo de docs/BRAND_ES.md — "Tres pilares de mensaje".
// Si se ajusta el copy acá, reflejar el cambio también en ese archivo.
const pilares = [
  {
    titulo: "Paciencia",
    texto: "Con calma y a tu ritmo, las veces que sea necesario.",
  },
  {
    titulo: "Autonomía",
    texto:
      "Vas a ganar independencia para resolver tus dudas.",
  },
  {
    titulo: "Accesibilidad",
    texto:
      "Diseño cada clase según tus habilidades y capacidades.",
  },
];
---

<section class="container py-16 md:py-20" aria-labelledby="pilares-titulo">
  <h2 id="pilares-titulo" class="text-2xl font-bold md:text-3xl">
    Así trabajo contigo
  </h2>

  <ul class="mt-8 grid list-none gap-6 p-0 md:grid-cols-3">
    {
      pilares.map((pilar) => (
        <li class="rounded-lg border border-black/10 bg-white/60 p-6">
          <h3 class="text-xl font-bold">{pilar.titulo}</h3>
          <p class="mt-2 text-base">{pilar.texto}</p>
        </li>
      ))
    }
  </ul>
</section>