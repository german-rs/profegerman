---
import WhatsAppCTA from "../ui/WhatsAppCTA.astro";

interface Props {
  titulo: string;
  texto?: string;
  ctaMensaje: string;
  ctaTexto: string;
}

const { titulo, texto, ctaMensaje, ctaTexto } = Astro.props;
---

<section
  class="container py-16 text-center md:py-20"
  aria-labelledby="cta-whatsapp-titulo"
>
  <h2 id="cta-whatsapp-titulo" class="text-2xl font-bold md:text-3xl">
    {titulo}
  </h2>

  {texto && <p class="mx-auto mt-3 max-w-prose text-base">{texto}</p>}

  <div class="mt-6 flex justify-center">
    <WhatsAppCTA message={ctaMensaje}>{ctaTexto}</WhatsAppCTA>
  </div>
</section>