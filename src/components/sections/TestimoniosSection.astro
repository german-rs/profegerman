---
import TestimonialCard from "../ui/TestimonialCard.astro";

// PLACEHOLDER: reemplazar los testimonios sin foto por las reales
// (nombre, cita, logro, curso, calificación — y foto cuando exista
// consentimiento). La forma de los datos ya calza con el schema de la
// futura collection "testimonios" documentado en docs/ARCHITECTURE.md.
// "logro" se sigue guardando aunque la tarjeta ya no lo muestre.
const testimonios = [
  {
    nombre: "Sergio Salazar",
    curso: "Autonomía digital",
    cita: "Germán es un profesor muy profesional y agradable y además tiene iniciativa para enseñar es muy efectivo y con mucha paciencia.",
    logro: "Lo recomiendo",
    calificacion: 5,
    foto: "/testimonios/Sergio-Salazar.jpg",
  },
     {
    nombre: "Rosa Elvira Pizarro",
    curso: "Alfabetización digital",
    cita: "Le tenía miedo al computador, pensaba que iba a echar a perder algo. Ahora hasta le enseño cosas a mi marido.",
    logro: "Perdió el miedo a usar el computador",
    calificacion: 5,
  },
  {
    nombre: "Israel Chavez",
    curso: "Autonomía digital",
    cita: "Aprender WordPress con Germán fue una gran experiencia. Gracias a sus enseñanzas pude desarrollar mis propios proyectos web.",
    logro: "Explica de forma clara, práctica y siempre esta dispuesto a ayudar. Totalmente recomendado.",
    calificacion: 5,
    foto: "/testimonios/Israel-Chavez.jpg",
  },
   {
    nombre: "María Elena Soto",
    curso: "Alfabetización digital",
    cita: "Nunca pensé que iba a poder mandarle fotos a mis nietos por WhatsApp. El profe me explicó todo con harta paciencia.",
    logro: "Ahora hace videollamadas con sus nietos",
    calificacion: 5,
  },

  {
    nombre: "Verónica Bembin",
    curso: "Autonomía digital",
    cita: "Excelente servicio, atención muy clara, rápida y eficaz. Resolvió todas las necesidades de mi empresa. 100% recomendado.",
    logro: "Ahora hace videollamadas con sus nietos",
    calificacion: 5,
    foto: "/testimonios/Veronica-Bembin.jpg",
  },
];
---

<section
  class="bg-primary/5 py-30 md:py-30"
  aria-labelledby="testimonios-titulo"
>
  <div class="container py-12 text-center">
    <p class="font-bold tracking-wide text-primary">
      Testimonios
    </p>

    
    <h2 id="testimonios-titulo" class="mt-3 text-2xl font-bold md:text-4xl">
      Lo que cuentan quienes ya tomaron clases
    </h2>

    <p class="mx-auto mt-3 max-w-prose text-base">
      Estudiantes que ya avanzaron a su ritmo, cada uno con su propio objetivo.
    </p>
  </div>

  <div class="container mt-16 md:mt-20">
    <div class="flex items-center gap-2 md:gap-6">
      <button
        type="button"
        id="testimonios-prev"
        class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full text-text/40 motion-safe:transition-colors hover:bg-black/5 hover:text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        aria-label="Ver testimonio anterior"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          class="h-6 w-6"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M15 6l-6 6 6 6" />
        </svg>
      </button>

      <ul
        id="testimonios-track"
        role="region"
        aria-label="Testimonios de alumnos. Usa las flechas o desliza para ver más"
        tabindex="0"
        class="testimonios-track flex min-w-0 flex-1 list-none gap-6 overflow-x-auto p-0"
      >
        {
          testimonios.map((testimonio) => (
            <li class="w-full shrink-0 snap-start sm:w-[calc((100%-1.5rem)/2)] lg:w-[calc((100%-3rem)/3)]">
              <TestimonialCard {...testimonio} />
            </li>
          ))
        }
      </ul>

      <button
        type="button"
        id="testimonios-next"
        class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full text-text/40 motion-safe:transition-colors hover:bg-black/5 hover:text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        aria-label="Ver siguiente testimonio"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          class="h-6 w-6"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M9 6l6 6-6 6" />
        </svg>
      </button>
    </div>

    <div id="testimonios-dots" class="mt-8 flex justify-center gap-1">
      {
        testimonios.map((testimonio, i) => (
          <button
            type="button"
            data-index={i}
            class="dot flex h-11 w-11 items-center justify-center"
            aria-label={`Ver testimonio de ${testimonio.nombre}`}
            aria-current={i === 0 ? "true" : "false"}
          >
            <span
              aria-hidden="true"
              class={`h-2.5 w-2.5 rounded-full motion-safe:transition-colors ${
                i === 0 ? "bg-primary" : "bg-text/20"
              }`}
            />
          </button>
        ))
      }
    </div>

    <div class="flex justify-center">
      <button
        type="button"
        id="testimonios-play-pause"
        class="flex h-11 w-11 items-center justify-center text-primary/60 motion-safe:transition-colors hover:text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        aria-label="Pausar avance automático de testimonios"
      >
        <svg
          id="icono-pausa"
          aria-hidden="true"
          viewBox="0 0 12 12"
          class="h-3 w-3"
          fill="currentColor"
        >
          <rect x="1.5" y="1" width="3" height="10" rx="0.5" />
          <rect x="7.5" y="1" width="3" height="10" rx="0.5" />
        </svg>
        <svg
          id="icono-play"
          aria-hidden="true"
          viewBox="0 0 12 12"
          class="hidden h-3 w-3"
          fill="currentColor"
        >
          <path d="M2 1.2v9.6l8-4.8-8-4.8Z" />
        </svg>
      </button>
    </div>
  </div>
</section>

<style>
  /*
   * Carrusel con avance automático (ver script abajo). Se pausa al
   * pasar el mouse o el foco por encima, tiene botón de pausa manual,
   * y no arranca si la persona tiene activado prefers-reduced-motion
   * en su sistema — así cumple con el checklist de accesibilidad de
   * WEB_STYLE_GUIDE_profegerman_v1.0.md sin perder el movimiento.
   */
  .testimonios-track {
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }

  .testimonios-track::-webkit-scrollbar {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .testimonios-track {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  const AUTOPLAY_DELAY_MS = 5000;

  const track = document.getElementById("testimonios-track");
  const prevBtn = document.getElementById("testimonios-prev");
  const nextBtn = document.getElementById("testimonios-next");
  const playPauseBtn = document.getElementById("testimonios-play-pause");
  const iconoPausa = document.getElementById("icono-pausa");
  const iconoPlay = document.getElementById("icono-play");
  const dotsContainer = document.getElementById("testimonios-dots");
  const dots = dotsContainer
    ? Array.from(dotsContainer.querySelectorAll<HTMLButtonElement>("[data-index]"))
    : [];

  if (track && prevBtn && nextBtn && playPauseBtn && iconoPausa && iconoPlay) {
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    let autoplayTimer: number | undefined;
    let isPlaying = !prefersReducedMotion;
    let activeIndex = 0;

    const getCardDistance = () => {
      const card = track.querySelector("li");
      if (!card) return 0;

      const trackStyles = window.getComputedStyle(track);
      const gap = parseFloat(trackStyles.columnGap || trackStyles.gap || "0");
      return card.clientWidth + gap;
    };

    const isAtEnd = () =>
      track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;

    const isAtStart = () => track.scrollLeft <= 4;

    const updateActiveDot = () => {
      if (dots.length === 0) return;

      const maxScrollLeft = track.scrollWidth - track.clientWidth;
      let index = 0;

      if (maxScrollLeft > 0) {
        const progress = track.scrollLeft / maxScrollLeft;
        index = Math.round(progress * (dots.length - 1));
      }

      index = Math.min(dots.length - 1, Math.max(0, index));

      if (index === activeIndex) return;
      activeIndex = index;

      dots.forEach((dot, i) => {
        const isActive = i === activeIndex;
        dot.setAttribute("aria-current", isActive ? "true" : "false");
        const span = dot.querySelector("span");
        span?.classList.toggle("bg-primary", isActive);
        span?.classList.toggle("bg-text/20", !isActive);
      });
    };

    const scrollToIndex = (index: number) => {
      const distance = getCardDistance();
      if (!distance) return;
      track.scrollTo({ left: distance * index, behavior: "smooth" });
    };

    const scrollByCard = (direction: number) => {
      // Loop del carrusel: al llegar a un extremo, "avanzar" vuelve
      // al otro extremo en vez de intentar seguir de largo.
      if (direction > 0 && isAtEnd()) {
        scrollToIndex(0);
        return;
      }
      if (direction < 0 && isAtStart()) {
        scrollToIndex(dots.length - 1);
        return;
      }

      const distance = getCardDistance();
      if (!distance) return;
      track.scrollBy({ left: distance * direction, behavior: "smooth" });
    };

    const updatePlayPauseButton = () => {
      playPauseBtn.setAttribute(
        "aria-label",
        isPlaying
          ? "Pausar avance automático de testimonios"
          : "Reanudar avance automático de testimonios"
      );
      iconoPausa.classList.toggle("hidden", !isPlaying);
      iconoPlay.classList.toggle("hidden", isPlaying);
    };

    const stopAutoplay = () => {
      window.clearInterval(autoplayTimer);
    };

    const startAutoplay = () => {
      stopAutoplay();
      if (!isPlaying) return;
      autoplayTimer = window.setInterval(
        () => scrollByCard(1),
        AUTOPLAY_DELAY_MS
      );
    };

    playPauseBtn.addEventListener("click", () => {
      isPlaying = !isPlaying;
      updatePlayPauseButton();
      isPlaying ? startAutoplay() : stopAutoplay();
    });

    prevBtn.addEventListener("click", () => scrollByCard(-1));
    nextBtn.addEventListener("click", () => scrollByCard(1));

    dots.forEach((dot, i) => {
      dot.addEventListener("click", () => scrollToIndex(i));
    });

    let scrollRaf: number | undefined;
    track.addEventListener(
      "scroll",
      () => {
        if (scrollRaf) return;
        scrollRaf = window.requestAnimationFrame(() => {
          updateActiveDot();
          scrollRaf = undefined;
        });
      },
      { passive: true }
    );

    // Pausa al pasar el mouse o el foco de teclado por encima del
    // carrusel (flechas incluidas), y retoma al salir.
    track.addEventListener("pointerenter", stopAutoplay);
    track.addEventListener("pointerleave", startAutoplay);
    track.addEventListener("focusin", stopAutoplay);
    track.addEventListener("focusout", startAutoplay);

    updatePlayPauseButton();
    updateActiveDot();
    startAutoplay();
  }
</script>