---
// src/components/sections/ContactoSection.astro
const FORMSPREE_ID = "xgawarrv";
const FORMSPREE_URL = `https://formspree.io/f/${FORMSPREE_ID}`;
---

<section id="contacto" class="container py-16 md:py-20" aria-labelledby="contacto-titulo">
  <div class="mx-auto max-w-2xl">
    <p class="text-sm font-semibold tracking-widest text-primary uppercase">
      Contacto
    </p>

    <h2 id="contacto-titulo" class="mt-2 text-2xl font-bold md:text-3xl">
      Hablemos de tus clases
    </h2>

    <p class="mt-3 max-w-prose text-base leading-relaxed">
      Cuéntame qué te gustaría aprender y cuándo tienes tiempo.
      Te respondo dentro de 24 horas.
    </p>

    <form
      id="contacto-form"
      action={FORMSPREE_URL}
      method="POST"
      novalidate
      class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2"
    >
    
      <div class="flex flex-col gap-1">
        <label for="nombre" class="text-sm font-bold">
          Nombre <span class="text-primary" aria-hidden="true">*</span>
        </label>
        <input
          type="text"
          id="nombre"
          name="nombre"
          required
          autocomplete="name"
          class="min-h-[2.75rem] rounded-lg border border-[#d4c5b5] bg-white px-4 py-2 text-base text-text transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/30"
        />
      </div>

      <div class="flex flex-col gap-1">
        <label for="correo" class="text-sm font-bold">
          Correo <span class="text-primary" aria-hidden="true">*</span>
        </label>
        <input
          type="email"
          id="correo"
          name="email"
          required
          autocomplete="email"
          class="min-h-[2.75rem] rounded-lg border border-[#d4c5b5] bg-white px-4 py-2 text-base text-text transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/30"
        />
      </div>

      <div class="flex flex-col gap-1">
        <label for="telefono" class="text-sm font-bold">Teléfono</label>
        <input
          type="tel"
          id="telefono"
          name="telefono"
          autocomplete="tel"
          class="min-h-[2.75rem] rounded-lg border border-[#d4c5b5] bg-white px-4 py-2 text-base text-text transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/30"
        />
      </div>

      <div class="flex flex-col gap-1">
        <label for="nivel" class="text-sm font-bold">
          ¿Qué te gustaría aprender?
        </label>
        <select
          id="nivel"
          name="nivel"
          class="min-h-[2.75rem] rounded-lg border border-[#d4c5b5] bg-white px-4 py-2 text-base text-text transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/30"
        >
          <option value="" disabled selected>Elige una opción</option>
          <option value="alfabetizacion">Alfabetización digital (desde cero)</option>
          <option value="autonomia">Autonomía digital (paso siguiente)</option>
          <option value="celular">Uso del celular</option>
          <option value="no-se">No sé por dónde partir</option>
        </select>
      </div>

      <!-- Mensaje -->
      <div class="flex flex-col gap-1 sm:col-span-2">
        <label for="mensaje" class="text-sm font-bold">
          Cuéntame un poco más <span class="text-primary" aria-hidden="true">*</span>
        </label>
        <textarea
          id="mensaje"
          name="mensaje"
          required
          rows="5"
          placeholder="Por ejemplo: quiero aprender a mandar fotos por WhatsApp, o necesito hacer trámites en línea…"
          class="rounded-lg border border-[#d4c5b5] bg-white px-4 py-3 text-base text-text transition-colors placeholder:text-[#9e8e80] focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/30"
        ></textarea>
      </div>

      <input type="text" name="_gotcha" class="hidden" tabindex="-1" aria-hidden="true" />

      <div class="flex flex-wrap items-center gap-4 sm:col-span-2">
        <button
          type="submit"
          id="contacto-submit"
          class="button button--primary min-w-[11rem]"
        >
          Enviar mensaje
        </button>
        <p class="text-sm text-[#7a6555]">
          Los campos con <span class="text-primary" aria-hidden="true">*</span> son obligatorios.
        </p>
      </div>

      <div
        id="contacto-feedback"
        role="status"
        aria-live="polite"
        aria-atomic="true"
        class="hidden sm:col-span-2"
      >
      </div>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById("contacto-form") as HTMLFormElement | null;
  const btn = document.getElementById("contacto-submit") as HTMLButtonElement | null;
  const feedback = document.getElementById("contacto-feedback") as HTMLElement | null;

  if (form && btn && feedback) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      btn.disabled = true;
      btn.textContent = "Enviando…";
      feedback.className = "hidden sm:col-span-2";
      feedback.textContent = "";

      try {
        const res = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });

        if (res.ok) {
          feedback.textContent = "¡Mensaje enviado! Te respondo dentro de 24 horas.";
          feedback.className =
            "rounded-lg border border-success/40 bg-success/10 p-4 text-base sm:col-span-2";
          form.reset();
        } else {
          throw new Error("server");
        }
      } catch {
        feedback.textContent =
          "Hubo un problema al enviar. Puedes escribirme también por WhatsApp.";
        feedback.className =
          "rounded-lg border border-primary/40 bg-primary/10 p-4 text-base sm:col-span-2";
      } finally {
        btn.disabled = false;
        btn.textContent = "Enviar mensaje";
      }
    });
  }
</script>