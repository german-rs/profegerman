---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import WhatsAppCTA from "../ui/WhatsAppCTA.astro";

interface Props {
  kicker?: string;
  titulo: string;
  subtitulo: string;
  ctaMensaje: string;
  ctaTexto: string;
  secondaryHref?: string;
  secondaryTexto?: string;
  imagen?: ImageMetadata;
  imagenAlt?: string;
  circuloClase?: string;
}

const {
  kicker,
  titulo,
  subtitulo,
  ctaMensaje,
  ctaTexto,
  secondaryHref,
  secondaryTexto,
  imagen,
  imagenAlt = "",
  circuloClase = "bg-primary/30",
} = Astro.props;
---

<section class="overflow-x-clip">
  <div
    class:list={[
      "container py-16 md:py-24",
      imagen && "grid items-center gap-10 md:grid-cols-2 md:gap-12",
    ]}
  >
    <div class:list={[!imagen && "max-w-3xl"]}>
      {kicker && <p class="mb-4 font-bold text-primary">{kicker}</p>}
      <h1 class="text-4xl font-bold tracking-tight md:text-5xl">{titulo}</h1>
      <p class="mt-6 max-w-prose text-xl">{subtitulo}</p>
      <div class="mt-8 flex flex-wrap gap-4">
        <WhatsAppCTA message={ctaMensaje}>{ctaTexto}</WhatsAppCTA>
        {
          secondaryHref && secondaryTexto && (
            <a class="button button--secondary" href={secondaryHref}>
              {secondaryTexto}
            </a>
          )
        }
      </div>
    </div>

    {
      imagen && (
        <div class="relative mx-auto w-full max-w-md md:max-w-none">
          <div
            aria-hidden="true"
            class:list={[
              "page-hero__circulo absolute bottom-[4%] left-[6%] aspect-square w-[88%] rounded-full md:left-auto md:-right-[6%]",
              circuloClase,
            ]}
          />
          <Image
            src={imagen}
            alt={imagenAlt}
            widths={[480, 720, 1000]}
            sizes="(min-width: 768px) 520px, 90vw"
            loading="eager"
            fetchpriority="high"
            class="page-hero__img relative z-10 mx-auto h-auto w-full max-w-[520px]"
          />
        </div>
      )
    }
  </div>
</section>

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    .page-hero__img {
      animation: page-hero-in 0.7s ease-out both;
    }
    .page-hero__circulo {
      animation: page-hero-fade 0.9s ease-out both;
    }
  }
  @keyframes page-hero-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes page-hero-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>