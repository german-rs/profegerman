---
import WhatsAppCTA from "../ui/WhatsAppCTA.astro";
---

<section class="container py-16 md:py-24">
  <div class="max-w-3xl">
    <p class="mb-4 font-bold text-primary">Clases de computación y celular</p>

    <h1 class="text-4xl font-bold tracking-tight md:text-6xl">
      Aprende a tu ritmo, sin sentirte perdido.
    </h1>

    <p class="mt-6 max-w-prose text-xl">
      Clases particulares para adultos y personas mayores, con paciencia,
      claridad y sin jerga técnica.
    </p>

    <div class="mt-8 flex flex-wrap gap-4">
      <WhatsAppCTA message="Hola profe, quiero saber más de las clases">
        Cuéntame qué quieres aprender
      </WhatsAppCTA>

      <a class="button button--secondary" href="/sobre-mi/">
        Conoce al profe
      </a>
    </div>
  </div>
</section>