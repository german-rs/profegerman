---
// src/components/sections/Hero.astro
import { buildWhatsAppLink } from '../../lib/whatsapp';
import HeroIllustration from '../ui/HeroIllustration.astro';

const whatsappHref = buildWhatsAppLink(
  'Hola, quiero contarte qué me gustaría aprender.'
);
---

<!--
  pt-18 compensa la altura del header fixed (min-h-18 = 4.5rem).
  El gradiente arranca en el azul-índigo del hero de GitHub
  y funde a canvas-primary hacia abajo.
-->
<section
  class="px-6 pt-[4.5rem] pb-16 sm:pb-20 lg:pb-28"
  style="background: linear-gradient(to bottom, #0c0d1e 0%, var(--color-canvas-primary) 100%);"
>
  <div class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-12 pt-16 sm:pt-20 lg:grid-cols-[1.15fr_1fr] lg:gap-16 lg:pt-28">

    <div>
      <p class="mb-4 font-semibold text-accent-subtle">
        Clases de computación y celular
      </p>

      <h1 class="text-4xl font-bold leading-tight text-fg-default sm:text-5xl lg:text-6xl">
        Aprende a tu ritmo, paso a paso y con confianza
      </h1>

      <p class="my-6 max-w-[60ch] text-lg leading-relaxed text-fg-body sm:text-xl">
        Clases particulares para adultos y personas mayores, con paciencia, claridad y cercanía.
      </p>

      <div class="my-10 lg:hidden">
        <HeroIllustration />
      </div>

      <div class="flex flex-col gap-4 sm:flex-row sm:flex-wrap">
        <!-- CTA principal -->
        <a
          href={whatsappHref}
          class="inline-flex min-h-[44px] items-center justify-center rounded-md bg-accent-emphasis px-6 py-3 font-semibold text-white motion-safe:transition-colors hover:bg-accent-default focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-lsch"
        >
          Cuéntame qué quieres aprender
        </a>

        <!-- CTA secundario -->
        <a
          href="/sobre-mi/"
          class="inline-flex min-h-[44px] items-center justify-center rounded-md border-2 border-border-default px-6 py-3 font-semibold text-fg-body motion-safe:transition-colors hover:border-fg-muted hover:bg-canvas-subtle hover:text-fg-default focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-lsch"
        >
          Conoce al profe
        </a>
      </div>
    </div>

    <div class="hidden lg:block">
      <HeroIllustration />
    </div>

  </div>
</section>