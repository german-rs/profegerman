---
// src/components/sections/Hero.astro
import { buildWhatsAppLink } from "../../lib/whatsapp";
import HeroIllustration from "../ui/HeroIllustration.astro";

const whatsappHref = buildWhatsAppLink(
  "Hola, quiero contarte qué me gustaría aprender.",
);
---

<section
  class="relative overflow-hidden bg-[#FDF8F3] px-6 pt-16 sm:pt-20 lg:min-h-[44rem]"
>
  <div class="container relative z-10 flex flex-col items-center text-center">
    <p class="mb-4 font-semibold text-primary">
      Clases de computación y celular
    </p>
      <h1 class="max-w-3xl text-balance text-4xl font-bold leading-tight text-[#2E2A27] sm:text-5xl">
     Aprende a tu ritmo, paso a paso y con&nbsp;confianza
   </h1>
    <p
      class="my-6 max-w-[44ch] text-lg leading-relaxed text-[#2E2A27] sm:text-xl"
    >
      Clases particulares para adultos y personas mayores, con paciencia,
      claridad y cercanía.
    </p>
    <div
      class="flex w-full flex-col gap-4 sm:w-auto sm:flex-row sm:flex-wrap sm:justify-center"
    >
      <a href={whatsappHref} class="button button--primary">
        Cuéntame qué quieres aprender
      </a>
      <a href="/sobre-mi/" class="button button--secondary"> Conoce al profe </a>
    </div>
  </div>

  <HeroIllustration />
</section>