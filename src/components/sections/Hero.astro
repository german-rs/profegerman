---
//src/components/sections/Hero.astro
import { buildWhatsAppLink } from "../../lib/whatsapp";
import HeroIllustration from "../ui/HeroIllustration.astro";

const whatsappHref = buildWhatsAppLink(
  "Hola, quiero contarte qué me gustaría aprender.",
);
---

<section class="bg-[#FDF8F3] px-6 py-16 sm:py-20 lg:py-24">
  <div
    class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-12 lg:grid-cols-[1fr_1.1fr] lg:gap-16"
  >
    <div>
      <p class="mb-4 font-semibold text-primary">
        Clases de computación y celular
      </p>
      <h1
        class="text-4xl font-bold leading-tight text-[#2E2A27] sm:text-5xl lg:text-6xl"
      >
        Aprende a tu ritmo, paso a paso y con confianza
      </h1>
      <p
        class="my-6 max-w-[60ch] text-lg leading-relaxed text-[#2E2A27] sm:text-xl"
      >
        Clases particulares para adultos y personas mayores, con paciencia,
        claridad y cercanía.
      </p>
      <div class="my-10 lg:hidden">
        <HeroIllustration />
      </div>
      <div class="flex flex-col gap-4 sm:flex-row sm:flex-wrap">
        <a href={whatsappHref} class="button button--primary">
          Cuéntame qué quieres aprender
        </a>
        <a href="/sobre-mi/" class="button button--secondary">
          Conoce al profe
        </a>
      </div>
    </div>
    <div class="hidden lg:block"><HeroIllustration /></div>
  </div>
</section>