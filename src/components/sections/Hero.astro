---
// src/components/sections/Hero.astro
import { buildWhatsAppLink } from '../../lib/whatsapp';
import HeroIllustration from '../ui/HeroIllustration.astro';

const whatsappHref = buildWhatsAppLink(
  'Hola, quiero contarte qué me gustaría aprender.'
);
---

<section class="bg-[#FDF8F3] px-6 py-16 sm:py-20 lg:py-28">
  <div class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-12 lg:grid-cols-[1.15fr_1fr] lg:gap-16">
    <div>
      <p class="mb-4 font-semibold text-[#D96C4B]">
        Clases de computación y celular
      </p>

      <h1 class="text-4xl font-bold leading-tight text-[#2E2A27] sm:text-5xl lg:text-6xl">
        Aprende a tu ritmo, paso a paso y con confianza
      </h1>

      <p class="mt-6 max-w-[60ch] text-lg leading-relaxed text-[#2E2A27] sm:text-xl">
        Clases particulares para adultos y personas mayores, con paciencia, claridad y cercanía.
      </p>

      <div class="my-10 lg:hidden">
        <HeroIllustration />
      </div>

      <div class="flex flex-col gap-4 sm:flex-row sm:flex-wrap">
        <a
          href={whatsappHref}
          class="inline-flex min-h-[44px] items-center justify-center rounded-md bg-[#D96C4B] px-6 py-3 font-semibold text-white motion-safe:transition-colors hover:bg-[#c25d3f] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#D96C4B]"
        >
          Cuéntame qué quieres aprender
        </a>
        <a
          href="/sobre-mi/"
          class="inline-flex min-h-[44px] items-center justify-center rounded-md border-2 border-[#2E2A27] px-6 py-3 font-semibold text-[#2E2A27] motion-safe:transition-colors hover:bg-[#2E2A27] hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#2E2A27]"
        >
          Conoce al profe
        </a>
      </div>
    </div>

    <div class="hidden lg:block">
      <HeroIllustration />
    </div>
  </div>
</section>