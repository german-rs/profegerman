---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import WhatsAppCTA from "../ui/WhatsAppCTA.astro";

interface Props {
  kicker?: string;
  titulo: string;
  subtitulo: string;
  ctaMensaje: string;
  ctaTexto: string;
  secondaryHref?: string;
  secondaryTexto?: string;
  imagen: ImageMetadata;
  imagenAlt: string;
}

const {
  kicker,
  titulo,
  subtitulo,
  ctaMensaje,
  ctaTexto,
  secondaryHref,
  secondaryTexto,
  imagen,
  imagenAlt,
} = Astro.props;
---

<section class="overflow-x-clip" data-hero>
  <div class="container grid items-center gap-10 py-16 md:grid-cols-[2fr_3fr] md:gap-16 md:py-24">
    <!-- Texto: primero en móvil, a la derecha en escritorio -->
    <div class="order-1 max-w-3xl md:order-2">
      {kicker && <p class="mb-4 font-bold text-primary">{kicker}</p>}

      <h1 class="text-4xl font-bold tracking-tight md:text-5xl">{titulo}</h1>

      <p class="mt-6 max-w-prose text-xl">{subtitulo}</p>

      <div class="mt-8 flex flex-wrap gap-4">
        <WhatsAppCTA message={ctaMensaje}>{ctaTexto}</WhatsAppCTA>

        {
          secondaryHref && secondaryTexto && (
            <a class="button button--secondary" href={secondaryHref}>
              {secondaryTexto}
            </a>
          )
        }
      </div>
    </div>

<!-- Escena -->
<div class="relative order-2 mx-auto flex h-[26rem] w-full max-w-sm items-end justify-center md:order-1 md:h-[34rem]">
  
    <!-- Capa 1: círculo (se retrasa y se encoge al hacer scroll) -->
    <div
  class="pointer-events-none absolute inset-0 -z-10 flex items-center justify-center"
  data-circulo
  data-shrink="0.35"
  aria-hidden="true"
    >
    <div class="hero-circulo size-72 rounded-full bg-profe/30 md:size-96">
    </div>
    
    </div>

  <!-- Capa 2: el profe -->
  <div class="relative h-full" data-parallax data-speed="0.1">
    <div class="hero-profe h-full">
      <Image
        src={imagen}
        alt={imagenAlt}
        class="h-full w-auto object-contain"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</div>
  </div>
</section>

<style>
  /* Solo se animan si la persona no pidió reducir el movimiento */
  @media (prefers-reduced-motion: no-preference) {
    .hero-circulo {
      animation: circulo-in 700ms ease-out both;
    }
    .hero-profe {
      animation: profe-in 700ms 200ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }
  }
  @keyframes circulo-in {
    from { opacity: 0; transform: scale(0.8); }
    to   { opacity: 1; transform: scale(1); }
  }
  @keyframes profe-in {
    from { opacity: 0; transform: translateY(2rem); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  const capas = document.querySelectorAll<HTMLElement>("[data-parallax]");
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  const circulo = document.querySelector<HTMLElement>("[data-circulo]");
  const interno = circulo?.firstElementChild as HTMLElement | null;
  const escena = circulo?.parentElement;
  const destino = document.querySelector<HTMLElement>("[data-destino]");
  const fondoDestino = document.querySelector<HTMLElement>("[data-destino-fondo]");
  const imgDestino = document.querySelector<HTMLElement>("[data-destino-img]");
  const reducirMovimiento = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (hero && circulo && interno && escena && !reducirMovimiento.matches) {
    const encoge = Number(circulo.dataset.shrink ?? 0);
    const RADIO_ABAJO = 24; // 1.5rem, igual que .arco
    const esAncho = window.matchMedia("(min-width: 768px)");
    const diametro = () => (esAncho.matches ? 384 : 288); // size-96 / size-72

    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
    const limitar = (t: number) => Math.min(Math.max(t, 0), 1);
    const suave = (t: number) => t * t * (3 - 2 * t);

    let inicioY = 0;
    let centroX = 0;
    let pendiente = false;

    // El círculo pasa a ser fijo y lo controla el script
    Object.assign(circulo.style, { position: "fixed", inset: "0 auto auto 0", display: "block" });
    Object.assign(interno.style, { width: "100%", height: "100%", borderRadius: "inherit" });
    if (fondoDestino) fondoDestino.style.opacity = "0";
    if (imgDestino) imgDestino.style.opacity = "0";

    const medir = () => {
      const r = escena.getBoundingClientRect();
      inicioY = r.top + window.scrollY + r.height / 2;
      centroX = r.left + r.width / 2;
    };

    const actualizar = () => {
      const y = Math.max(window.scrollY, 0);
      const vh = document.documentElement.clientHeight;

      // Fase 1: baja por detrás del hero y se encoge
      const p = limitar(y / (hero.offsetHeight * 0.8));
      const s = 1 - (1 - p) ** 2;
      const d = diametro() * (1 - s * encoge);
      const reposo = vh * 0.55;

      let x = centroX;
      let yc = Math.max(inicioY - y, inicioY + (reposo - inicioY) * s);
      let w = d;
      let h = d;
      let rArriba = d / 2;
      let rAbajo = d / 2;
      let m = 0;

      // Fase 2: se transforma en el arco de "Quién soy"
      if (destino) {
        const dr = destino.getBoundingClientRect();
        const fin = Math.max(dr.top + y - vh * 0.2, 60);
        const inicio = Math.max(fin - vh * 0.9, 0);
        m = suave(limitar((y - inicio) / (fin - inicio)));

        x = lerp(x, dr.left + dr.width / 2, m);
        yc = lerp(yc, dr.top + dr.height / 2, m);
        w = lerp(d, dr.width, m);
        h = lerp(d, dr.height, m);
        rArriba = lerp(d / 2, dr.width / 2, m);
        rAbajo = lerp(d / 2, RADIO_ABAJO, m);
      }

      circulo.style.width = `${w}px`;
      circulo.style.height = `${h}px`;
      circulo.style.borderRadius = `${rArriba}px ${rArriba}px ${rAbajo}px ${rAbajo}px`;
      circulo.style.transform = `translate3d(${x - w / 2}px, ${yc - h / 2}px, 0)`;

      // Al aterrizar, el arco real toma el relevo y la ilustración aparece
      const aterrizado = m > 0.999;
      circulo.style.opacity = aterrizado ? "0" : "1";
      if (fondoDestino) fondoDestino.style.opacity = aterrizado ? "1" : "0";
      if (imgDestino) imgDestino.style.opacity = String(suave(limitar((m - 0.6) / 0.4)));

      // Parallax simple del resto de capas (el profe del hero)
      const yHero = Math.min(y, hero.offsetHeight);
      capas.forEach((capa) => {
        const velocidad = Number(capa.dataset.speed ?? 0);
        capa.style.transform = `translate3d(0, ${yHero * velocidad}px, 0)`;
      });

      pendiente = false;
    };

    const pedirActualizacion = () => {
      if (!pendiente) {
        pendiente = true;
        requestAnimationFrame(actualizar);
      }
    };

    const recalcular = () => {
      medir();
      pedirActualizacion();
    };

    window.addEventListener("scroll", pedirActualizacion, { passive: true });
    window.addEventListener("resize", recalcular);
    window.addEventListener("load", recalcular);
    recalcular();
  }
</script>