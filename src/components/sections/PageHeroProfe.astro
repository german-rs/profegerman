---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import WhatsAppCTA from "../ui/WhatsAppCTA.astro";

interface Props {
  kicker?: string;
  titulo: string;
  subtitulo: string;
  ctaMensaje: string;
  ctaTexto: string;
  secondaryHref?: string;
  secondaryTexto?: string;
  imagen: ImageMetadata;
  imagenAlt: string;
}

const {
  kicker,
  titulo,
  subtitulo,
  ctaMensaje,
  ctaTexto,
  secondaryHref,
  secondaryTexto,
  imagen,
  imagenAlt,
} = Astro.props;
---

<section class="overflow-hidden">
  <div class="container grid items-center gap-10 py-16 md:grid-cols-[2fr_3fr] md:gap-16 md:py-24">
    <!-- Texto: primero en móvil, a la derecha en escritorio -->
    <div class="order-1 max-w-3xl md:order-2">
      {kicker && <p class="mb-4 font-bold text-primary">{kicker}</p>}

      <h1 class="text-4xl font-bold tracking-tight md:text-5xl">{titulo}</h1>

      <p class="mt-6 max-w-prose text-xl">{subtitulo}</p>

      <div class="mt-8 flex flex-wrap gap-4">
        <WhatsAppCTA message={ctaMensaje}>{ctaTexto}</WhatsAppCTA>

        {
          secondaryHref && secondaryTexto && (
            <a class="button button--secondary" href={secondaryHref}>
              {secondaryTexto}
            </a>
          )
        }
      </div>
    </div>

<!-- Escena -->
<!-- Escena -->
<div class="relative order-2 mx-auto flex h-[26rem] w-full max-w-sm items-end justify-center md:order-1 md:h-[34rem]">
  <!-- Capa 1: círculo (la que más se retrasa) -->
  <div
    class="absolute inset-0 flex items-center justify-center"
    data-parallax
    data-speed="0.25"
    aria-hidden="true"
  >
    <div class="hero-circulo size-72 rounded-full bg-profe/30 md:size-96"></div>
  </div>

  <!-- Capa 2: el profe -->
  <div class="relative h-full" data-parallax data-speed="0.1">
    <div class="hero-profe h-full">
      <Image
        src={imagen}
        alt={imagenAlt}
        class="h-full w-auto object-contain"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</div>
  </div>
</section>

<style>
  /* Solo se animan si la persona no pidió reducir el movimiento */
  @media (prefers-reduced-motion: no-preference) {
    .hero-circulo {
      animation: circulo-in 700ms ease-out both;
    }
    .hero-profe {
      animation: profe-in 700ms 200ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }
  }
  @keyframes circulo-in {
    from { opacity: 0; transform: scale(0.8); }
    to   { opacity: 1; transform: scale(1); }
  }
  @keyframes profe-in {
    from { opacity: 0; transform: translateY(2rem); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  // Parallax: solo en pantallas medianas o más y sin "reducir movimiento"
  const capas = document.querySelectorAll<HTMLElement>("[data-parallax]");
  const permitido = window.matchMedia(
    "(prefers-reduced-motion: no-preference) and (min-width: 768px)"
  );

  if (capas.length && permitido.matches) {
    let pendiente = false;

    const actualizar = () => {
      const y = Math.min(window.scrollY, 800);
      capas.forEach((capa) => {
        const velocidad = Number(capa.dataset.speed ?? 0);
        capa.style.transform = `translate3d(0, ${y * velocidad}px, 0)`;
      });
      pendiente = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (!pendiente) {
          pendiente = true;
          requestAnimationFrame(actualizar);
        }
      },
      { passive: true }
    );
  }
</script>