---
import type { Faq } from "../../data/faq";
import FaqSchema from "../seo/FaqSchema.astro";

interface Props {
  eyebrow?: string;
  titulo: string;
  intro?: string;
  preguntas: Faq[];
  abrirPrimera?: boolean;
}

const { eyebrow, titulo, intro, preguntas, abrirPrimera = false } = Astro.props;
---

<section
  id="preguntas-frecuentes"
  class="reveal container py-20 md:py-28"
  aria-labelledby="faq-titulo"
>
  <FaqSchema items={preguntas} />

  <header class="mx-auto mb-10 max-w-2xl text-center md:mb-14">
    {eyebrow && <p class="mb-3 font-semibold text-primary">{eyebrow}</p>}
    <h2 id="faq-titulo" class="text-2xl font-bold md:text-3xl">{titulo}</h2>
    {intro && <p class="mt-3 text-base">{intro}</p>}
  </header>

  <div class="mx-auto max-w-3xl">
    {
      preguntas.map(({ pregunta, respuesta }, i) => (
        <details
          name="faq"
          open={abrirPrimera && i === 0}
          class="group border-b border-[#2E2A27]/15 first:border-t [interpolate-size:allow-keywords] [&::details-content]:h-0 [&::details-content]:overflow-clip motion-safe:[&::details-content]:transition-[height,content-visibility] motion-safe:[&::details-content]:duration-300 motion-safe:[&::details-content]:[transition-behavior:allow-discrete] open:[&::details-content]:h-auto"
        >
          <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-6 py-5 text-lg font-bold hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary md:py-6 [&::-webkit-details-marker]:hidden">
            <span>{pregunta}</span>
            <span
              aria-hidden="true"
              class="flex size-8 shrink-0 items-center justify-center rounded-full border border-primary/40 text-primary motion-safe:transition-colors group-open:border-primary group-open:bg-primary group-open:text-white"
            >
              <svg
                viewBox="0 0 16 16"
                class="size-4"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              >
                <path d="M3 8h10" />
                <path
                  d="M8 3v10"
                  class="origin-center [transform-box:fill-box] motion-safe:transition-transform motion-safe:duration-300 group-open:scale-y-0"
                />
              </svg>
            </span>
          </summary>
          <p class="max-w-[620px] pb-6 pr-12 text-base leading-relaxed">
            {respuesta}
          </p>
        </details>
      ))
    }
  </div>
</section>