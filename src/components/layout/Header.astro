---
import WhatsAppCTA from "../ui/WhatsAppCTA.astro";
import MobileNav from "./MobileNav.astro";

const links = [
  { href: "/alfabetizacion-digital/", label: "Clases" },
  { href: "/sobre-mi/", label: "Sobre mí" },
];
---

<header class="border-b border-black/10 bg-background">
  <div class="container flex min-h-18 items-center justify-between gap-4">
    <a
      href="/"
      class="text-link shrink-0 text-xl font-bold no-underline"
      aria-label="Profe Germán, inicio"
    >
      Profe Germán
    </a>

    <!-- Navegación de escritorio -->
    <nav aria-label="Navegación principal" class="hidden md:block">
      <ul class="flex list-none items-center gap-5 p-0">
        {
          links.map((link) => (
            <li>
              <a class="text-link" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }

        <li>
          <WhatsAppCTA message="Hola profe, quiero saber más de las clases">
            WhatsApp
          </WhatsAppCTA>
        </li>
      </ul>
    </nav>

    <MobileNav links={links} />
  </div>
</header>