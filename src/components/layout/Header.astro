---
import WhatsAppCTA from "../ui/WhatsAppCTA.astro";
import MobileNav from "./MobileNav.astro";

const links = [
  { href: "/alfabetizacion-digital/", label: "Clases" },
  { href: "/sobre-mi/", label: "Sobre mí" },
];
---

<header
  data-header
  class="fixed top-0 left-0 right-0 z-50 border-b border-transparent transition-colors duration-200"
>
  <div class="container flex min-h-18 items-center justify-between gap-4">
    <a href="/" class="text-link shrink-0 text-xl font-bold no-underline" aria-label="Profe Germán, inicio">
      Profe Germán
    </a>
    <nav aria-label="Navegación principal" class="hidden md:block">
      <ul class="flex list-none items-center gap-5 p-0">
        {links.map((link) => (
          <li><a class="text-link" href={link.href}>{link.label}</a></li>
        ))}
        <li>
          <WhatsAppCTA message="Hola profe, quiero saber más de las clases">WhatsApp</WhatsAppCTA>
        </li>
      </ul>
    </nav>
    <MobileNav links={links} />
  </div>
</header>

<script>
  const header = document.querySelector('[data-header]') as HTMLElement | null;
  if (header) {
    const THRESHOLD = 40;
    const update = () => header.classList.toggle('header--scrolled', window.scrollY > THRESHOLD);
    window.addEventListener('scroll', update, { passive: true });
    update();
  }
</script>

<style>
  [data-header].header--scrolled {
    background-color: rgba(22, 27, 34, 0.92);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border-bottom-color: var(--color-border-default);
  }
</style>