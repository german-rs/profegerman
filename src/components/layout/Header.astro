---
import WhatsAppCTA from "../ui/WhatsAppCTA.astro";
import MobileNav from "./MobileNav.astro";

const links = [
  { href: "/alfabetizacion-digital/", label: "Clases" },
  { href: "/sobre-mi/", label: "Sobre mí" },
];
---

<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-transparent bg-transparent motion-safe:transition-[background-color,box-shadow,border-color] motion-safe:duration-200 motion-safe:ease-out"
>
  <div class="container flex min-h-18 items-center justify-between gap-4">
    <a
      href="/"
      class="text-link shrink-0 text-xl font-bold no-underline"
      aria-label="Profe Germán, inicio"
    >
      Profe Germán
    </a>

    <!-- Navegación de escritorio -->
    <nav aria-label="Navegación principal" class="hidden md:block">
      <ul class="flex list-none items-center gap-5 p-0">
        {
          links.map((link) => (
            <li>
              <a class="text-link" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <WhatsAppCTA message="Hola profe, quiero saber más de las clases">
            WhatsApp
          </WhatsAppCTA>
        </li>
      </ul>
    </nav>

    <MobileNav links={links} />
  </div>
</header>

<script>
  const header = document.getElementById("site-header");

  if (header) {
    const SCROLL_THRESHOLD = 24;
    let ticking = false;

    const updateHeader = () => {
      const scrolled = window.scrollY > SCROLL_THRESHOLD;

      header.classList.toggle("bg-transparent", !scrolled);
      header.classList.toggle("border-transparent", !scrolled);

      header.classList.toggle("bg-background/90", scrolled);
      header.classList.toggle("backdrop-blur-md", scrolled);
      header.classList.toggle("border-black/10", scrolled);
      header.classList.toggle("shadow-sm", scrolled);

      ticking = false;
    };

    updateHeader();

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          window.requestAnimationFrame(updateHeader);
          ticking = true;
        }
      },
      { passive: true },
    );
  }
</script>