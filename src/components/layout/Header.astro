---
import WhatsAppCTA from "../ui/WhatsAppCTA.astro";
---

<header class="border-b border-black/10 bg-background">
  <div class="container flex min-h-18 items-center justify-between gap-6">
    <a
      href="/"
      class="text-link text-xl font-bold no-underline"
      aria-label="Profe Germán, inicio"
    >
      Profe Germán
    </a>

    <nav aria-label="Navegación principal">
      <ul class="flex list-none items-center gap-5 p-0">
        <li>
          <a class="text-link" href="/alfabetizacion-digital/">
            Clases
          </a>
        </li>

        <li>
          <a class="text-link" href="/sobre-mi/">
            Sobre mí
          </a>
        </li>

        <li>
          <WhatsAppCTA message="Hola profe, quiero saber más de las clases">
            WhatsApp
          </WhatsAppCTA>
        </li>
      </ul>
    </nav>
  </div>
</header>