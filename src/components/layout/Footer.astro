---
/**
 * Footer con despedida: los personajes se asoman por detrás de dos olas.
 * La ola de atrás se mueve, la de adelante queda quieta (para que el niño no "flote"),
 * y el color de la ola de adelante continúa como fondo de los datos del sitio.
 * Colores: cambia solo las variables de abajo, en el bloque <style>.
 */
const whatsappHref =
  "https://wa.me/56982960453?text=Hola%20profe%2C%20quiero%20saber%20m%C3%A1s%20de%20las%20clases";
const olaPath = "M0,30 C200,60 400,0 600,30 C800,60 1000,0 1200,30 L1200,60 L0,60 Z";
---

<footer class="bg-background pt-16 md:pt-24">
  <!-- Despedida -->
  <section aria-labelledby="despedida-titulo">
    <div class="container flex flex-col items-center text-center">
      <h2 id="despedida-titulo" class="m-0 text-2xl font-bold md:text-3xl">
        Gracias por pasar. ¡Hasta pronto!
      </h2>
      <p class="m-0 mt-3 max-w-prose text-base">
        Aquí estaré cuando quieras partir.
      </p>
    </div>

    <!-- Escena: olas a ancho completo, personajes centrados -->
    <div class="relative isolate mt-10 overflow-x-clip" aria-hidden="true">
      <!-- Ola de atrás (z-[1]: queda por delante del círculo, que está en z-0) -->
      <div class="capa capa-atras absolute inset-x-0 bottom-0 z-[1] flex h-[56%] flex-col">
        <div class="relative h-10 shrink-0 overflow-hidden md:h-14">
          <svg
            viewBox="0 0 2400 60"
            preserveAspectRatio="none"
            class="wave-track wave-track--lenta absolute left-0 top-0 h-full w-[200%]"
          >
            <path d={olaPath}></path>
            <path d={olaPath} transform="translate(1200,0)"></path>
          </svg>
        </div>
        <div class="relleno flex-1"></div>
      </div>

      <!-- Caja de referencia para posicionar a los personajes -->
      <div class="relative mx-auto aspect-square w-full max-w-5xl sm:aspect-[3/2] lg:aspect-[2/1]">
        <!-- Círculo-sol detrás del grupo: la ola de atrás le tapa la mitad de abajo -->
        <div
          class="sol absolute bottom-[16%] left-[-1%] z-0 aspect-square w-[72%] rounded-full sm:bottom-[32%] sm:left-[16%] sm:w-[40%] lg:bottom-[24%] lg:left-[21%] lg:w-[34%]"
        >
        </div>

        <!-- Madre, padre y hermana: de cuerpo completo, la ola de adelante les tapa las piernas -->
        <img
          src="/illustrations/despedida-grupo.webp"
          alt=""
          width="1208"
          height="1280"
          loading="lazy"
          decoding="async"
          class="absolute bottom-0 left-[2%] z-10 h-auto w-[66%] sm:left-[10%] sm:w-[52%] lg:left-[16%] lg:w-[44%]"
        />

        <!-- Hermano sentado, por delante de la ola frontal y más cerca del grupo -->
        <img
          src="/illustrations/despedida-hermano.webp"
          alt=""
          width="1024"
          height="1536"
          loading="lazy"
          decoding="async"
          class="absolute bottom-[1%] right-0 z-30 h-auto w-[38%] sm:bottom-[-4%] sm:right-[10%] sm:w-[30%] lg:bottom-[-8%] lg:right-[17%] lg:w-[25%]"
        />
      </div>

      <!-- Ola de adelante (quieta) -->
      <div class="capa capa-frente absolute inset-x-0 bottom-0 z-20 flex h-[34%] flex-col">
        <div class="relative h-10 shrink-0 overflow-hidden md:h-14">
          <svg
            viewBox="0 0 2400 60"
            preserveAspectRatio="none"
            class="wave-track absolute left-0 top-0 h-full w-[200%]"
          >
            <path d={olaPath}></path>
            <path d={olaPath} transform="translate(1200,0)"></path>
          </svg>
        </div>
        <div class="relleno flex-1"></div>
      </div>
    </div>
  </section>

  <!-- Datos del sitio: mismo color que la ola de adelante, sin corte -->
  <div class="bg-[var(--ola-frente)]">
    <div class="container flex flex-col gap-6 py-10 md:flex-row md:items-center md:justify-between">
      <div>
        <p class="m-0 font-bold">Profe Germán</p>
        <p class="mt-2 max-w-prose text-base">
          Clases de computación, celular y alfabetización digital para adultos.
        </p>
      </div>
      <nav aria-label="Navegación secundaria">
        <ul class="m-0 flex list-none flex-wrap gap-x-6 gap-y-3 p-0 text-base">
          <li><a class="text-link" href="/accesibilidad/">Accesibilidad</a></li>
          <li><a class="text-link" href="/sobre-mi/">Sobre mí</a></li>
          <li>
            <a class="text-link" href={whatsappHref} rel="noopener noreferrer">WhatsApp</a>
          </li>
          <li>
            <a class="text-link" href="https://germanriveros.cl" rel="noopener noreferrer">germanriveros.cl</a>
          </li>
        </ul>
      </nav>
    </div>

    <div class="border-t border-black/10 bg-black/[0.04]">
      <div class="container py-5">
        <p class="m-0 text-base">
          © {new Date().getFullYear()} Profe Germán. Todos los derechos reservados.
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Paleta del footer. Colores OPACOS a propósito: la ola de adelante debe tapar las piernas.
     Atrás: salvia (el mismo verde de la banda de contacto, un tono más oscuro).
     Adelante: terracota suave. Sol: terracota aún más suave. */
  footer {
    --ola-atras: #dae3d2;
    --ola-frente: #f2cec1;
    --sol: #f8dfd5;
  }

  .capa-atras { --c: var(--ola-atras); }
  .capa-frente { --c: var(--ola-frente); }
  .capa .relleno { background: var(--c); }
  .capa path { fill: var(--c); }
  .sol { background: var(--sol); }

  /* Dos copias de la ola, desplazadas -50 % en loop: la unión es invisible. */
  .wave-track { animation: wave-scroll 18s linear infinite; }
  .wave-track--lenta { animation-duration: 28s; animation-direction: reverse; }

  /* La ola de adelante queda quieta: el niño está sentado en ella y no debe subir ni bajar. */
  .capa-frente .wave-track { animation: none; }

  @keyframes wave-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .wave-track { animation: none; }
  }
</style>