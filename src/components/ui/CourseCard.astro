---
export interface Props {
  titulo: string;
  nivel: string;
  duracion: string;
  resumen: string;
  temas: string[];
  href: string;
  imagen?: string;
  imagenAlt?: string;
  acento?: "primary" | "success";
  valor?: string;
  modalidad?: string;
}

const { titulo, nivel, duracion, resumen, temas, href, imagen, imagenAlt, acento = "primary", valor, modalidad } = Astro.props;

const manchas = {
  primary: "bg-primary/30",
  success: "bg-success/30",
};

---

<article class="card-hover flex flex-col rounded-lg bg-white/60 p-6">
  {imagen && (
    <img
      src={imagen}
      alt={imagenAlt ?? ""}
      width="160"
      height="160"
      class:list={["w-40 h-40 object-cover rounded-full mx-auto mb-6 mt-2", manchas[acento]]}
      loading="lazy"
      decoding="async"
    />
  )}

  <p class="m-0 text-sm font-bold tracking-wide text-primary">
    {nivel}
  </p>
  <h3 class="mt-2 text-2xl font-bold">{titulo}</h3>
  <p class="mt-3 text-base">{resumen}</p>
  <ul class="mt-4 list-none space-y-2 p-0 text-base">
    {
      temas.map((tema) => (
        <li class="flex items-start gap-2">
          <span aria-hidden="true">✓</span>
          <span>{tema}</span>
        </li>
      ))
    }
  </ul>
<dl class="mt-4 space-y-1 text-base">
  <div class="flex gap-2"><dt class="font-bold">Duración:</dt><dd>{duracion}</dd></div>
  {valor && <div class="flex gap-2"><dt class="font-bold">Valor:</dt><dd>{valor}</dd></div>}
  {modalidad && <div class="flex gap-2"><dt class="font-bold">Modalidad:</dt><dd>{modalidad}</dd></div>}
</dl>
  <a class="button button--secondary mt-6 self-start" href={href}>
    Ver detalles de {titulo}
  </a>
</article>

