---
import { buildWhatsAppLink } from "../../lib/whatsapp";

interface Props {
  message?: string;
  variant?: "primary" | "secondary";
  class?: string;
}

const { message, variant = "primary", class: className = "" } = Astro.props;
const href = buildWhatsAppLink(message);
---

<a
  class={`button button--${variant} ${className} hover:shadow-[0_10px_20px_-6px_rgba(46,42,39,0.35)] motion-safe:transition-[box-shadow,transform] motion-safe:duration-200 motion-safe:ease-out motion-safe:hover:-translate-y-0.5 motion-safe:active:translate-y-0`.trim()}
  href={href}
  rel="noopener noreferrer"
>
  <slot />
</a>