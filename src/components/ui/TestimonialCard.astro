---
interface Props {
  nombre: string;
  curso?: string;
  cita: string;
  calificacion?: number;
  foto?: string;
}

const { nombre, curso, cita, calificacion = 5, foto } = Astro.props;

// Iniciales como placeholder visual mientras no hay foto real con
// consentimiento (ver docs/WEB_STYLE_GUIDE_profegerman_v1.0.md —
// nunca fotografía stock genérica). Cuando exista `foto`, se muestra
// la imagen real en su lugar; si no, se mantiene este fallback.
const iniciales = nombre
  .split(" ")
  .filter(Boolean)
  .slice(0, 2)
  .map((palabra) => palabra[0])
  .join("")
  .toUpperCase();

const estrellas = Array.from({ length: 5 }, (_, i) => i < calificacion);
---

<article class="flex h-full flex-col items-center px-2 text-center">
  <div
    class="flex items-center gap-1 text-primary"
    role="img"
    aria-label={`Calificación: ${calificacion} de 5 estrellas`}
  >
    {
      estrellas.map((llena) => (
        <svg
          aria-hidden="true"
          viewBox="0 0 20 20"
          class="h-4 w-4"
          fill={llena ? "currentColor" : "none"}
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M10 1.6l2.47 5.39 5.78.6-4.36 4.02 1.24 5.79L10 14.6l-5.13 2.8 1.24-5.79L1.75 7.6l5.78-.6L10 1.6Z"
          />
        </svg>
      ))
    }
  </div>

  <p class="mt-5 max-w-[42ch] flex-1 text-lg italic leading-relaxed">
    &ldquo;{cita}&rdquo;
  </p>

  {
    foto ? (
      <img
        src={foto}
        alt={`Foto de ${nombre}`}
        loading="lazy"
        decoding="async"
        class="mt-6 h-14 w-14 shrink-0 rounded-full object-cover"
      />
    ) : (
      <span
        aria-hidden="true"
        class="mt-6 flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-primary/15 text-lg font-bold text-primary"
      >
        {iniciales}
      </span>
    )
  }

  <p class="mt-3 font-bold">{nombre}</p>
  {curso && <p class="text-sm text-text/70">{curso}</p>}
</article>