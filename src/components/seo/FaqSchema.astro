---
import type { Faq } from "../../data/faq";

interface Props {
  items: Faq[];
}

const { items } = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map(({ pregunta, respuesta }) => ({
    "@type": "Question",
    name: pregunta,
    acceptedAnswer: {
      "@type": "Answer",
      text: respuesta,
    },
  })),
};

// Escapar "<" evita que un texto cierre el <script> por accidente
const json = JSON.stringify(jsonLd).replace(/</g, "\\u003c");
---

<script type="application/ld+json" set:html={json} />